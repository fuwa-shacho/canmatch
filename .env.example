APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI Gateway 経由にする場合(本番用。手元では不要):
# GEMINI_BASE_URL=https://gateway.ai.cloudflare.com/v1/<アカウントID>/canmatch/google-ai-studio/v1beta
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PROMPT=vending_read_v1
GEMINI_RETRY_WAIT=10
# gemini-3 系は thinkingLevel を使う。minimal にする
GEMINI_THINKING_LEVEL=minimal

PHOTOS_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=canmatch-dev
R2_ENDPOINT=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_EMBEDDING_MODEL=@cf/baai/bge-m3
CF_VECTORIZE_INDEX=canmatch-products
CF_TIMEOUT=30

# 回答の生成(Issue 65)
# 採用:gemma(DISABLE_THINKING=true が必要)
# 予備:@cf/mistralai/mistral-small-3.1-24b-instruct(DISABLE_THINKING=false にする。true だと 400)
CF_GENERATION_MODEL=@cf/google/gemma-4-26b-a4b-it
CF_GENERATION_MAX_TOKENS=400
CF_ANSWER_PROMPT=rag_answer_v1
CF_GENERATION_DISABLE_THINKING=true
CF_GENERATION_JSON_MODE=true

# 登録時のボット対策 Cloudflare Turnstile(Issue #48)。使うときだけ true にして鍵を設定する
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
